# --- Large or regeneratable data ---
# Kaggle dataset — download manually and place here
train.csv

# Subsample created by notebooks/scripts from train.csv
data/train_subsampled.csv

# Local BERT weights (~1.5 GB) — download from Hugging Face:
#   huggingface-cli download distilbert-base-uncased --local-dir models/distilbert-base-uncased
models/

# BERT training checkpoints (~10 GB) — retrain with scripts/run_bert_cv.py
results/bert/checkpoints/

# LLM raw inference cache — regenerated by scripts/run_llm_cv.py
results/llm/cache/

# Generated report binary (source is REPORT.md)
*.docx

# --- Keep these (not ignored) ---
# results/bert/all_folds_metrics.csv, fold_*_metrics.csv, summary.json
# results/llm/**/all_folds_metrics.csv, fold_*_metrics.csv, summary.json
# results/comparison/*.csv
# data/fold_indices/metadata.json
